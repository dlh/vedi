#!/bin/sh
# Prints the release notes for TAG: its CHANGELOG.md entry, without the
# heading. Default: the first entry. Fails when there is none.
# Usage: bin/release-notes [TAG]
set -eu

main() {
    cd "$(git rev-parse --show-toplevel)"
    notes=$(awk -v tag="${1:-}" '
        /^## / { if (p) exit; p = tag == "" || $2 == tag; next }
        p && (NF || started) { started = 1; print }' CHANGELOG.md)
    if [ -z "$notes" ]; then
        echo "CHANGELOG.md has no entry for ${1:-a release}" >&2
        exit 1
    fi
    printf '%s\n' "$notes"
}

main "$@"
