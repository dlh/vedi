#!/bin/sh
# Runs the criterion benchmarks at BASE (default main), saving them as
# baseline "base", then in the working tree, where criterion compares
# against that baseline and prints the change per benchmark. COUNT is
# the sample size (default 100, at least 10). The target directory is
# shared so the working tree finds BASE's baseline.
# Usage: bin/bench-compare [BASE] [COUNT]
set -eu
base=${1:-main}
count=${2:-100}
[ "$count" -ge 10 ] || { echo "COUNT must be at least 10" >&2; exit 2; }
root=$(git rev-parse --show-toplevel)
export CARGO_TARGET_DIR="${CARGO_TARGET_DIR:-$root/target}"
tmp=$(mktemp -d)
trap 'git -C "$root" worktree remove --force "$tmp/base" 2>/dev/null || true; rm -rf "$tmp"' EXIT
git -C "$root" worktree add -q --detach "$tmp/base" "$base"
[ -d "$tmp/base/vedi/benches" ] || { echo "$base has no criterion benches" >&2; exit 2; }
# A baseline left by an earlier BASE would be compared silently.
if [ -d "$CARGO_TARGET_DIR/criterion" ]; then
	find "$CARGO_TARGET_DIR/criterion" -type d -name base -prune -exec rm -rf {} +
fi
echo "benchmarking $base" >&2
(cd "$tmp/base" && cargo bench -p vedi -- --sample-size "$count" --save-baseline base)
echo "benchmarking working tree" >&2
# Lenient: benchmarks new since BASE have no baseline.
cd "$root" && cargo bench -p vedi -- --sample-size "$count" --baseline-lenient base
